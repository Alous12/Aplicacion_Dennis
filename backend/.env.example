# Copia este archivo como .env (NO lo subas a git) y completa los valores.

# Clave secreta para firmar los JWT. Genera una larga y aleatoria, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_EXPIRES_IN=12h

# Cuenta de servicio de Firebase (Consola Firebase → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada)
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# Pega la clave entre comillas, con los \n tal cual vienen en el JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Solo si el frontend corre en otro dominio (en local se usa el proxy de Angular, no hace falta)
CORS_ORIGIN=
PORT=3000
